# =============================================================================
# NEHA CROCKERY HOUSE — ENVIRONMENT VARIABLE TEMPLATE
# Copy this file to .env and fill in real values locally.
# For Render: set these in Dashboard -> Your Service -> Environment tab.
# =============================================================================

# ── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=10000

# ── Supabase Database URLs ───────────────────────────────────────────────────
# Go to: Supabase Dashboard -> Your Project -> Settings -> Database -> URI tab
#
# DATABASE_URL -> Transaction mode (port 6543) + ?pgbouncer=true&connection_limit=1
# DIRECT_URL   -> Session mode (port 5432), used by Prisma migrations only

DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRES_IN=7d
JWT_COOKIE_EXPIRES_DAYS=7

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (Vercel domain + custom domain)
CORS_ORIGINS=https://nehacrockery.com,https://neha-crockery.vercel.app

# ── Supabase Auth ─────────────────────────────────────────────────────────────
# Go to: Supabase Dashboard -> Settings -> API
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Go to: Supabase Dashboard -> Settings -> API -> JWT Settings
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# ── File Uploads ──────────────────────────────────────────────────────────────
# Files are uploaded to Supabase Storage (persistent, no disk dependency).
# Buckets to create in Supabase Dashboard -> Storage:
#   product-images  (public)
#   catalogues      (public)
#   shop-gallery    (public)
STORAGE_STRATEGY=supabase
UPLOAD_MAX_SIZE_MB=10

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=10
